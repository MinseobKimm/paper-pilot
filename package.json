{
  "name": "paper-pilot",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "npm run build",
    "test:tables": "node scripts/test-ai-tables.mjs",
    "test:chat": "node scripts/test-paper-chat.mjs",
    "test:citations": "node scripts/test-paper-citations.mjs",
    "test:layout": "node scripts/test-pdf-layout.mjs",
    "test:word-meanings": "node scripts/test-word-meanings.mjs",
    "setup:python": "node scripts/setup-python.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "build:mac": "tauri build --config src-tauri/tauri.macos.conf.json --bundles app && node scripts/sync-mac-app.mjs",
    "build:mac:dmg": "tauri build --config src-tauri/tauri.macos.conf.json --bundles dmg",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:scholarly": "node scripts/test-scholarly.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "katex": "^0.16.46",
    "pdfjs-dist": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sbd": "^1.0.19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
